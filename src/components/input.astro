---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'input'> & {
  variant?: 'field' | 'muted'
}

const { variant = 'field', class: className, ...attrs } = Astro.props
---

<input class:list={[`variant-${variant}`, className]} {...attrs} />

<style>
  input {
    inline-size: 100%;
    max-inline-size: 100%;
    border-radius: var(--radius-control);
    color: var(--color-text);
    transition: border-color 180ms ease;
  }

  .variant-field {
    block-size: var(--control-height-sm);
    padding-inline: 20px;
    border: 1px solid var(--color-border-field);
    background-color: var(--color-bg);
    font-size: 12px;
  }

  .variant-field::placeholder {
    color: var(--color-accent);
    opacity: 1;
  }

  .variant-muted {
    block-size: 41px;
    padding-inline: 10px;
    border: 1px solid transparent;
    background-color: var(--color-surface-muted);
    text-align: center;
  }

  @media (hover: hover) and (pointer: fine) {
    input:hover {
      border-color: var(--color-accent);
    }
  }

  input:focus-visible {
    border-color: var(--color-accent);
    outline: 3px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
    outline-offset: 0;
  }

  input[aria-invalid='true'] {
    border-color: var(--color-label);
  }

  @media (prefers-reduced-motion: reduce) {
    input {
      transition: none;
    }
  }
</style>
