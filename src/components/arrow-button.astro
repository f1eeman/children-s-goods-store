---
import type { HTMLAttributes } from 'astro/types'

import ArrowDisabled from '@/img/icons/arrow-disabled.svg'
import Arrow from '@/img/icons/arrow.svg'

type Props = HTMLAttributes<'button'> & {
  direction: 'prev' | 'next'
  label: string
}

const {
  direction,
  label,
  class: className,
  disabled = false,
  ...attrs
} = Astro.props
---

<button
  class:list={['arrow', `direction-${direction}`, className]}
  type="button"
  aria-label={label}
  {disabled}
  {...attrs}
>
  <Arrow class="glyph glyph-enabled" aria-hidden="true" />
  <ArrowDisabled class="glyph glyph-disabled" aria-hidden="true" />
</button>

<style>
  .arrow {
    position: relative;
    flex: none;
    inline-size: 38px;
    block-size: 38px;
    border-radius: 50%;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .direction-next {
    transform: rotate(180deg);
  }

  .glyph {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .glyph-disabled,
  .arrow:disabled .glyph-enabled {
    opacity: 0;
  }

  .arrow:disabled .glyph-disabled {
    opacity: 1;
  }

  .arrow:disabled {
    cursor: default;
  }

  .arrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .arrow:not(:disabled):hover {
      transform: scale(1.06);
    }

    .direction-next:not(:disabled):hover {
      transform: rotate(180deg) scale(1.06);
    }
  }

  .arrow:not(:disabled):active {
    transform: scale(0.94);
    transition-duration: 90ms;
  }

  .direction-next:not(:disabled):active {
    transform: rotate(180deg) scale(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }

    .arrow:not(:disabled):hover,
    .arrow:not(:disabled):active {
      transform: none;
    }

    .direction-next:not(:disabled):hover,
    .direction-next:not(:disabled):active {
      transform: rotate(180deg);
    }
  }
</style>
