---
import { Image } from 'astro:assets'

import Button from '@/components/button.astro'
import { SITE } from '@/data/site'
import Clock from '@/img/icons/clock.svg'
import Phone from '@/img/icons/phone.svg'
import map from '@/img/map.jpg'
---

<section
  class="section"
  id="contacts"
  data-region
  aria-labelledby="contacts-title"
>
  <div class="container">
    <h2 class="section-title" id="contacts-title">Наши контакты</h2>

    <div class="grid" data-reveal data-reveal-stagger>
      <div class="panel">
        <div class="card">
          <p class="address">{SITE.address}</p>

          <p class="hours-title">Часы работы магазина</p>

          <div class="rows">
            <div class="hours">
              <Clock class="row-icon" aria-hidden="true" />
              <dl class="schedule">
                {
                  SITE.schedule.map((item) => (
                    <div class="schedule-row">
                      <dt>{item.days}</dt>
                      <dd>{item.hours}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <a class="phone" href={`tel:${SITE.shopPhone.href}`}>
              <Phone class="row-icon" aria-hidden="true" />
              {SITE.shopPhone.label}
            </a>
          </div>
        </div>

        <Button as="a" href="/catalog/" class="cta">Заказать доставку</Button>
      </div>

      <div class="map" data-map>
        <Image
          class="map-photo"
          src={map}
          alt={`Карта: ${SITE.address}`}
          widths={[656, 1200]}
          sizes="(width >= 1024px) 656px, 100vw"
          loading="lazy"
          data-map-photo
        />

        <div class="zoom">
          <button
            class="zoom-button"
            type="button"
            aria-label="Приблизить карту"
            data-map-in
          >
            +
          </button>
          <button
            class="zoom-button"
            type="button"
            aria-label="Отдалить карту"
            data-map-out
            disabled
          >
            –
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initMapZoom } from '@/scripts/map-zoom'

  initMapZoom()
</script>

<style>
  .grid {
    display: grid;
    gap: 20px;
    margin-block-start: 28px;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: center;
    padding: 20px;
    border-radius: var(--radius-block);
    background-color: var(--color-surface-contacts);
  }

  .card {
    inline-size: 100%;
    padding: 20px;
    border-radius: var(--radius-block);
    background-color: var(--color-surface-card);
  }

  .address {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.5;
  }

  .hours-title {
    margin-block-start: 24px;
    font-weight: 700;
    line-height: 1.2;
  }

  .rows {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-block-start: 20px;
    color: var(--color-text-muted);
  }

  .hours {
    display: flex;
    gap: 10px;
  }

  .row-icon {
    flex: none;
    inline-size: 20px;
    block-size: 20px;
  }

  .schedule-row {
    display: grid;
    grid-template-columns: 54px auto;
    gap: 25px;
    line-height: 1.2;
  }

  .schedule-row + .schedule-row {
    margin-block-start: 9px;
  }

  .phone {
    display: flex;
    gap: 10px;
    align-items: start;
    line-height: 1.2;
    transition: color 180ms ease;
  }

  .cta {
    min-inline-size: 183px;
  }

  .map {
    position: relative;
    border-radius: var(--radius-block);
    background-color: var(--color-surface-muted);
    overflow: hidden;
  }

  .map-photo {
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 656 / 585;
    object-fit: cover;
    transform-origin: center;
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .zoom {
    position: absolute;
    inset-block-start: 20px;
    inset-inline-start: 20px;
    display: grid;
    gap: 15px;
  }

  .zoom-button {
    display: grid;
    place-content: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
      opacity 180ms ease;
  }

  .zoom-button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .zoom-button:focus-visible,
  .phone:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .zoom-button:not(:disabled):hover {
      transform: scale(1.06);
    }

    .phone:hover {
      color: var(--color-accent);
    }
  }

  .zoom-button:not(:disabled):active {
    transform: scale(0.94);
  }

  @media (width >= 768px) {
    .grid {
      margin-block-start: 40px;
    }

    .panel {
      padding: 30px;
    }

    .card {
      padding: 30px 20px;
    }

    .zoom-button {
      inline-size: 53px;
      block-size: 53px;
      font-size: 30px;
    }
  }

  @media (width >= 1024px) {
    .grid {
      grid-template-columns: 494px minmax(0, 1fr);
      align-items: stretch;
    }

    .panel {
      justify-content: space-between;
    }

    .card {
      flex: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-photo,
    .zoom-button,
    .phone {
      transition: none;
    }

    .zoom-button:not(:disabled):hover,
    .zoom-button:not(:disabled):active {
      transform: none;
    }
  }
</style>
