---
import type { Section } from '@/data/pages'

interface Props {
  sections: Section[]
}

const { sections } = Astro.props
---

<div class="content">
  {
    sections.map((section) => (
      <section class="block">
        <h2 class="heading">{section.heading}</h2>

        {section.paragraphs?.map((text) => (
          <p class="text">{text}</p>
        ))}

        {section.list !== undefined && (
          <ul class="list">
            {section.list.map((item) => (
              <li class="item">{item}</li>
            ))}
          </ul>
        )}

        {section.cards !== undefined && (
          <ul class="cards">
            {section.cards.map((card) => (
              <li class="card">
                <h3 class="card-title">{card.title}</h3>
                <p class="card-text">{card.text}</p>
              </li>
            ))}
          </ul>
        )}

        {section.table !== undefined && (
          <div class="table-scroll" role="group" tabindex="0">
            <table class="table">
              <thead>
                <tr>
                  {section.table.head.map((cell) => (
                    <th scope="col">{cell}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {section.table.rows.map((row) => (
                  <tr>
                    {row.map((cell, index) =>
                      index === 0 ? (
                        <th scope="row">{cell}</th>
                      ) : (
                        <td>{cell}</td>
                      ),
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    ))
  }
</div>

<style>
  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  .heading {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.5;
  }

  .text {
    max-inline-size: 720px;
    margin-block-start: 12px;
    line-height: 1.5;
  }

  .list {
    display: grid;
    gap: 10px;
    max-inline-size: 720px;
    margin-block-start: 16px;
  }

  .item {
    position: relative;
    padding-inline-start: 22px;
    line-height: 1.5;
  }

  .item::before {
    content: '';
    position: absolute;
    inset-block-start: 10px;
    inset-inline-start: 0;
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-block-start: 20px;
  }

  .card {
    padding: 20px;
    border-radius: var(--radius-block);
    background-color: var(--color-surface-muted);
  }

  .card-title {
    font-weight: 700;
    font-size: 16px;
    line-height: 1.5;
  }

  .card-text {
    margin-block-start: 8px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .table-scroll {
    margin-block-start: 20px;
    overflow-x: auto;
  }

  .table-scroll:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .table {
    inline-size: 100%;
    min-inline-size: 480px;
    border-collapse: collapse;
    text-align: start;
  }

  .table th,
  .table td {
    padding: 14px 16px 14px 0;
    border-block-end: 1px solid var(--color-surface-muted);
    line-height: 1.5;
    text-align: start;
    vertical-align: top;
  }

  .table thead th {
    font-weight: 700;
  }

  .table tbody th {
    font-weight: 400;
    color: var(--color-text-params);
  }

  @media (width >= 768px) {
    .content {
      gap: 40px;
    }

    .heading {
      font-size: 20px;
    }
  }
</style>
