---
import { PRICE_LIMITS } from '@/data/catalog'

const { min, max } = PRICE_LIMITS
---

<div class="range" data-price-range>
  <div class="slider">
    <span class="track" aria-hidden="true"></span>
    <span class="fill" aria-hidden="true" data-price-fill></span>
    <input
      class="thumb"
      type="range"
      {min}
      {max}
      value={min}
      step="10"
      aria-label="Цена от"
      data-price-range-min
    />
    <input
      class="thumb"
      type="range"
      {min}
      {max}
      value={max}
      step="10"
      aria-label="Цена до"
      data-price-range-max
    />
  </div>

  <div class="fields">
    <span class="caption">от</span>
    <span class="money">
      <input
        class="money-input"
        type="number"
        {min}
        {max}
        value={min}
        inputmode="numeric"
        aria-label="Цена от, рублей"
        data-price-input-min
      />
      <span class="unit">₽</span>
    </span>

    <span class="caption">до</span>
    <span class="money">
      <input
        class="money-input"
        type="number"
        {min}
        {max}
        value={max}
        inputmode="numeric"
        aria-label="Цена до, рублей"
        data-price-input-max
      />
      <span class="unit">₽</span>
    </span>
  </div>
</div>

<style>
  .slider {
    position: relative;
    block-size: 24px;
  }

  .track,
  .fill {
    position: absolute;
    inset-block-start: 50%;
    border-radius: var(--radius-pill);
    transform: translateY(-50%);
  }

  .track {
    inset-inline: 0;
    block-size: 1px;
    background-color: var(--color-surface-muted);
  }

  .fill {
    inset-inline: var(--fill-start, 0%) var(--fill-end, 0%);
    block-size: 3px;
    background-color: var(--color-accent);
  }

  .thumb {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    inline-size: 100%;
    block-size: 24px;
    margin: 0;
    background: none;
    appearance: none;
    pointer-events: none;
  }

  .thumb::-webkit-slider-thumb {
    inline-size: 24px;
    block-size: 24px;
    border: none;
    border-radius: 50%;
    background-color: var(--color-accent);
    appearance: none;
    pointer-events: auto;
    cursor: pointer;
  }

  .thumb::-moz-range-thumb {
    inline-size: 24px;
    block-size: 24px;
    border: none;
    border-radius: 50%;
    background-color: var(--color-accent);
    pointer-events: auto;
    cursor: pointer;
  }

  .thumb:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .thumb:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .fields {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 8px;
    align-items: center;
    margin-block-start: 16px;
  }

  .caption {
    line-height: 1.2;
  }

  .money {
    display: flex;
    gap: 4px;
    align-items: center;
    justify-content: center;
    block-size: 41px;
    padding-inline: 8px;
    border-radius: var(--radius-control);
    background-color: var(--color-surface-muted);
  }

  .money-input {
    inline-size: 100%;
    min-inline-size: 0;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    text-align: end;
    appearance: textfield;
  }

  .money-input::-webkit-outer-spin-button,
  .money-input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .money-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (pointer: fine) {
    .thumb::-webkit-slider-thumb {
      inline-size: 12px;
      block-size: 12px;
    }

    .thumb::-moz-range-thumb {
      inline-size: 12px;
      block-size: 12px;
    }
  }
</style>
