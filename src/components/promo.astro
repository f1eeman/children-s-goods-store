---
import { Image } from 'astro:assets'

import Button from '@/components/button.astro'
import Carousel from '@/components/carousel.astro'
import { SLIDES } from '@/data/promo'
---

<section class="section promo" aria-label="Акции магазина">
  <div class="container">
    <Carousel label="Акции магазина" variant="slides" dots>
      {
        SLIDES.map((slide, index) => (
          <article class="slide">
            <div class="art">
              <Image
                class="photo"
                src={slide.image}
                alt={slide.alt}
                widths={[768, 1170, 1600]}
                sizes="(width >= 1250px) 1170px, 100vw"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>

            <span class="shape shape-soft" aria-hidden="true" />
            <span class="shape shape-main" aria-hidden="true" />

            <div class="copy">
              {index === 0 ? (
                <h1 class="title">{slide.title}</h1>
              ) : (
                <p class="title">{slide.title}</p>
              )}
              <p class="subtitle">{slide.subtitle}</p>
              <Button as="a" href={slide.href} variant="light" class="cta">
                {slide.cta}
              </Button>
            </div>

            {slide.badge !== undefined && (
              <p class="badge">
                <span class="badge-caption">{slide.badge.caption}</span>
                <span class="badge-value">{slide.badge.value}</span>
              </p>
            )}
          </article>
        ))
      }
    </Carousel>
  </div>
</section>

<style>
  .slide {
    position: relative;
    border-radius: var(--radius-block);
    background-color: var(--color-banner-bg);
    overflow: hidden;
  }

  .photo {
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .shape {
    display: none;
  }

  .copy {
    padding: 24px 20px 28px;
    background-color: var(--color-banner-shape);
  }

  .title {
    font-weight: 700;
    font-size: 22px;
    line-height: 1.5;
    color: var(--color-text-on-accent);
  }

  .subtitle {
    margin-block-start: 4px;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-on-accent);
    opacity: 0.8;
  }

  .cta {
    align-self: start;
    margin-block-start: 20px;
    min-inline-size: 124px;
  }

  .badge {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-end: 12px;
    display: grid;
    place-content: center;
    inline-size: 88px;
    block-size: 88px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-text-on-accent);
    text-align: center;
    transform: rotate(8.64deg);
  }

  .badge-caption {
    display: block;
    font-size: 12px;
    line-height: 1.5;
  }

  .badge-value {
    display: block;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.5;
  }

  @media (width >= 768px) {
    .slide {
      display: grid;
      grid-template-columns: 44% minmax(0, 1fr);
      min-block-size: 240px;
    }

    .art {
      position: absolute;
      inset: 0;
    }

    .photo {
      aspect-ratio: auto;
    }

    .shape {
      position: absolute;
      display: block;
      inset-block-start: 0;
      inset-inline-start: 0;
      inline-size: 56.3%;
      border-radius: 50%;
      aspect-ratio: 1;
    }

    .shape-soft {
      translate: -20.9% -17.8%;
      background-color: var(--color-banner-shape-soft);
    }

    .shape-main {
      translate: -27.9% -19.9%;
      background-color: var(--color-banner-shape);
    }

    .copy {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      grid-column: 1;
      justify-content: center;
      padding: 24px 20px 24px 5.5%;
      background-color: transparent;
    }

    .title {
      font-size: 24px;
    }

    .subtitle {
      font-size: 18px;
    }

    .badge {
      inset-block: auto 4%;
      inset-inline-end: 2.3%;
      inline-size: auto;
      block-size: 43.4%;
      aspect-ratio: 1;
    }

    .badge-caption {
      font-size: 14px;
    }

    .badge-value {
      font-size: 34px;
    }
  }

  @media (width >= 1024px) {
    .slide {
      grid-template-columns: 38% minmax(0, 1fr);
      min-block-size: 304px;
    }

    .title {
      font-size: 30px;
    }

    .subtitle {
      font-size: 20px;
    }

    .badge-value {
      font-size: 40px;
    }

    .badge-caption {
      font-size: 16px;
    }
  }
</style>
