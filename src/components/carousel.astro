---
import ArrowButton from '@/components/arrow-button.astro'

interface Props {
  label: string
  title?: string
  variant?: 'cards' | 'slides' | 'tiles'
  dots?: boolean
  class?: string
}

const {
  label,
  title,
  variant = 'cards',
  dots = false,
  class: className,
} = Astro.props
---

<div class:list={['carousel', `variant-${variant}`, className]} data-carousel>
  {title !== undefined && <h2 class="section-title heading">{title}</h2>}

  <div class="frame">
    <ArrowButton
      class="arrow"
      direction="prev"
      label="Назад"
      disabled
      data-carousel-prev
    />

    <div
      class="viewport"
      data-carousel-viewport
      tabindex="0"
      role="group"
      aria-label={label}
    >
      <div class="track"><slot /></div>
    </div>

    <ArrowButton
      class="arrow"
      direction="next"
      label="Вперёд"
      disabled
      data-carousel-next
    />
  </div>

  {
    dots && (
      <div class="dots" data-carousel-dots hidden>
        <div class="dots-row" data-carousel-dots-row />
      </div>
    )
  }
</div>

<style>
  .heading {
    margin-block-end: 24px;
  }

  .frame {
    display: grid;
    grid-template-areas:
      'viewport viewport'
      'prev next';
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
  }

  .viewport {
    grid-area: viewport;
    inline-size: 100%;
    margin-inline: -15px;
    padding: 15px;
    overflow-x: auto;
    scroll-padding-inline: 15px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .viewport::-webkit-scrollbar {
    display: none;
  }

  .viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .track {
    display: flex;
    gap: 30px;
    align-items: start;
  }

  .variant-cards .track > :global(*) {
    flex: 0 0 clamp(240px, 72vw, 270px);
    scroll-snap-align: start;
  }

  .variant-tiles .track > :global(*) {
    flex: 0 0 clamp(180px, 55vw, 215px);
    scroll-snap-align: start;
  }

  .variant-slides .track > :global(*) {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .arrow[data-carousel-prev] {
    grid-area: prev;
    justify-self: end;
    margin-inline-end: 12px;
  }

  .arrow[data-carousel-next] {
    grid-area: next;
    justify-self: start;
    margin-inline-start: 12px;
  }

  .dots {
    display: flex;
    justify-content: center;
    margin-block-start: 20px;
  }

  .dots-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  @media (width >= 768px) {
    .frame {
      grid-template-areas: 'prev viewport next';
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
    }

    .arrow[data-carousel-prev] {
      grid-area: prev;
      justify-self: center;
      margin-inline-end: 0;
    }

    .arrow[data-carousel-next] {
      grid-area: next;
      justify-self: center;
      margin-inline-start: 0;
    }

    .heading {
      margin-block-end: 28px;
    }
  }

  @media (width >= 1250px) {
    .variant-cards .track,
    .variant-tiles .track {
      justify-content: center;
    }
  }
</style>
