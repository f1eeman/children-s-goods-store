---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class:list={['chip', className]}><slot /></span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 62px;
    min-block-size: 32px;
    padding-inline: 13px;
    border-radius: var(--radius-control);
    background-color: var(--color-label);
    color: var(--color-text-on-accent);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  @media (width >= 768px) {
    .chip {
      min-inline-size: 73px;
      min-block-size: 40px;
      padding-inline: 16px;
      font-size: 14px;
      letter-spacing: 1.68px;
    }
  }
</style>
