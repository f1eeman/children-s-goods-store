---
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag = 'button'> = Polymorphic<{ as: Tag }> & {
  variant?: 'accent' | 'light' | 'light-ink'
  size?: 'sm' | 'md'
}

const {
  as: Tag = 'button',
  class: className,
  variant = 'accent',
  size = 'sm',
  ...attrs
} = Astro.props
---

<Tag
  class:list={['base-button', `variant-${variant}`, `size-${size}`, className]}
  {...attrs}
>
  <slot />
</Tag>

<style>
  .base-button {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    padding-inline: 19px;
    border-radius: var(--radius-control);
    font: inherit;
    font-weight: 700;
    font-size: 12px;
    line-height: 1;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition:
      background-color 180ms ease,
      transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .size-sm {
    min-block-size: var(--control-height-sm);
  }

  .size-md {
    min-block-size: var(--control-height);
  }

  .variant-accent {
    background-color: var(--color-accent);
    color: var(--color-text-on-accent);
  }

  .variant-light,
  .variant-light-ink {
    background-color: var(--color-bg);
  }

  .variant-light {
    color: var(--color-accent);
  }

  .variant-light-ink {
    color: var(--color-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .base-button:hover {
      transform: translateY(-2px);
    }

    .variant-accent:hover {
      background-color: color-mix(in srgb, var(--color-accent) 88%, #fff);
    }

    .variant-light:hover,
    .variant-light-ink:hover {
      background-color: color-mix(
        in srgb,
        var(--color-bg) 94%,
        var(--color-accent)
      );
    }
  }

  .base-button:focus-visible {
    transform: translateY(-2px);
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .variant-light:focus-visible,
  .variant-light-ink:focus-visible {
    outline-color: var(--color-bg);
  }

  .base-button:active {
    transform: translateY(0) scale(0.97);
    transition-duration: 90ms;
  }

  .variant-accent:active {
    background-color: color-mix(in srgb, var(--color-accent) 85%, #000);
  }

  .variant-light:active,
  .variant-light-ink:active {
    background-color: color-mix(
      in srgb,
      var(--color-bg) 88%,
      var(--color-accent)
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .base-button {
      transition: background-color 180ms ease;
    }

    .base-button:focus-visible,
    .base-button:active {
      transform: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .base-button:hover {
        transform: none;
      }
    }
  }
</style>
