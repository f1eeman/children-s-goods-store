---
import { CATEGORIES, ROOT_CATEGORY } from '@/data/catalog'

interface Props {
  current: string
}

const { current } = Astro.props

const items = [ROOT_CATEGORY, ...CATEGORIES]
---

<nav class="tabs" aria-label="Категории каталога">
  <ul class="list">
    {
      items.map((category) => (
        <li>
          <a
            class="tab"
            href={`/catalog/${category.slug === ROOT_CATEGORY.slug ? '' : `${category.slug}/`}`}
            aria-current={category.slug === current ? 'page' : undefined}
          >
            {category.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tab {
    display: block;
    padding: 8px 16px;
    border-radius: var(--radius-control);
    background-color: var(--color-surface-muted);
    font-size: 14px;
    line-height: 1.2;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .tab[aria-current='page'] {
    background-color: var(--color-accent);
    color: var(--color-text-on-accent);
  }

  .tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .tab:not([aria-current='page']):hover {
      background-color: color-mix(
        in srgb,
        var(--color-surface-muted) 80%,
        var(--color-accent)
      );
      color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
  }
</style>
