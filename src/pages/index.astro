---
import Advantages from '@/components/advantages.astro'
import Banner from '@/components/banner.astro'
import Categories from '@/components/categories.astro'
import Contacts from '@/components/contacts.astro'
import Promo from '@/components/promo.astro'
import ProductStrip from '@/components/product-strip.astro'
import { REQUEST_BANNER } from '@/data/banners'
import { POPULAR, RECENT } from '@/data/catalog'
import Layout from '@/layouts/Layout.astro'

const title = 'MERRY — детская одежда и товары для малышей'
const description =
  'Магазин детских товаров MERRY в Санкт-Петербурге: одежда, шапки, купальники и обувь. Доставка почтой бесплатная при заказе от 5000 рублей.'
---

<Layout {title} {description}>
  <Promo />
  <Advantages />
  <Categories />
  <ProductStrip
    id="popular-title"
    title="Популярные товары"
    products={POPULAR}
  />

  <section class="section" data-region aria-label="Акция магазина">
    <div class="container">
      <Banner banner={REQUEST_BANNER} />
    </div>
  </section>

  <ProductStrip
    id="recent-title"
    title="Недавно просмотренное"
    products={RECENT}
  />
  <Contacts />
</Layout>
