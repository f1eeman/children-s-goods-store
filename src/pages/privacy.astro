---
import PageHeader from '@/components/page-header.astro'
import Layout from '@/layouts/Layout.astro'

const title = 'Политика конфиденциальности — MERRY'
const description =
  'Политика конфиденциальности: какие данные собираются в магазине MERRY и как они обрабатываются.'
---

<Layout {title} {description}>
  <PageHeader
    crumbs={[
      { label: 'Главная', href: '/' },
      { label: 'Политика конфиденциальности' },
    ]}
    title="Политика конфиденциальности"
    lead="Текст политики готовится. Пока его нет, магазин не собирает данные через сайт: заказ оформляется звонком или письмом, а форм на страницах нет."
  />

  <section class="section page" aria-label="Текст политики">
    <div class="container">
      <p class="note">
        Документ появится здесь до запуска. Вопросы о данных — по телефону и
        почте из раздела контактов.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page {
    min-block-size: 240px;
  }

  .note {
    max-inline-size: 720px;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
