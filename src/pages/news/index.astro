---
import { Image } from 'astro:assets'

import PageHeader from '@/components/page-header.astro'
import { NEWS, dateLabel } from '@/data/news'
import Layout from '@/layouts/Layout.astro'

const title = 'Новости магазина MERRY'
const description =
  'Новинки, подборки и разборы от магазина детских товаров MERRY: что привезли, как выбрать размер и зачем детской одежде сертификаты.'
---

<Layout {title} {description}>
  <PageHeader
    crumbs={[{ label: 'Главная', href: '/' }, { label: 'Новости' }]}
    title="Новости"
    lead={NEWS.lead}
  />

  <section class="section" aria-label="Список новостей">
    <div class="container">
      <ul class="list">
        {
          NEWS.posts.map((post) => (
            <li class="item">
              <a class="card" href={`/news/${post.slug}/`}>
                <span class="shot">
                  <Image
                    class="photo"
                    src={post.image}
                    alt=""
                    widths={[360, 720]}
                    sizes="(width >= 1024px) 360px, (width >= 600px) 45vw, 90vw"
                    loading="lazy"
                  />
                </span>
                <span class="body">
                  <time class="date" datetime={post.date}>
                    {dateLabel(post.date)}
                  </time>
                  <span class="title">{post.title}</span>
                  <span class="lead">{post.lead}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
  }

  .card {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border-radius: var(--radius-block);
    overflow: hidden;
    background-color: var(--color-surface-card);
    transition: box-shadow 180ms ease;
  }

  .shot {
    display: block;
    overflow: hidden;
  }

  .photo {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 20px 0 0;
  }

  .date {
    color: var(--color-text-subtle);
    font-size: 14px;
    line-height: 1.2;
  }

  .title {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.5;
  }

  .lead {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .photo {
      transform: scale(1.04);
    }

    .card:hover .title {
      color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .photo {
      transition: none;
    }

    .card:hover .photo {
      transform: none;
    }
  }
</style>
