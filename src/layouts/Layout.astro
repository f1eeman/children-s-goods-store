---
import { Font } from 'astro:assets'

import Footer from '@/components/footer.astro'
import Header from '@/components/header.astro'
import Seo from '@/components/seo.astro'
import { PRICES } from '@/data/catalog'

import '@/styles/index.css'

interface Props {
  title: string
  description: string
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {title} {description} {noindex} />
    <Font
      cssVariable="--font-comfortaa"
      preload={[{ weight: 400 }, { weight: 700 }]}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <p
      class="visually-hidden"
      role="status"
      data-cart-live
      data-cart-live-added="%s — в корзине"
      data-cart-live-removed="Товар убран из корзины"
      data-cart-live-cleared="Корзина пуста"
      data-cart-live-qty="%n шт., %s"
      data-cart-live-failed="Браузер не разрешает хранить корзину: список не сохранится"
    >
    </p>

    <script
      type="application/json"
      data-cart-prices
      is:inline
      set:html={JSON.stringify(PRICES)}
    />

    <script>
      import { initCarousel } from '@/scripts/carousel'
      import { initCart } from '@/scripts/cart'
      import { initReveal } from '@/scripts/reveal'

      initCarousel()
      initCart()
      initReveal()
    </script>
  </body>
</html>
